# Docker-ийн host портууд (itam 3000/4000-ийг эзэлдэг). API зөвхөн 127.0.0.1-д нээгдэнэ.
WEB_PORT=3300
API_PORT=4300

# nginx/Caddy зэрэг reverse proxy-ийн ард ажиллуулбал true (proxy нь X-Forwarded-For-ийг бичнэ).
BEHIND_PROXY=false

# QR-ийн холбоосыг хэрэглэгч өөрчилж болох домэйнууд (таслалаар, дэд домэйн автоматаар зөвшөөрөгдөнө)
QR_ALLOWED_HOSTS=teso.mn
